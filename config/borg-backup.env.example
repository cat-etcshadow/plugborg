# copy to /etc/borg/borg-backup.env and edit; sourced by scripts/ and udev/*.tmpl

# paths to back up
BACKUP_SOURCES=(/home/youruser)

# should live outside BACKUP_SOURCES
LOCAL_REPO=/var/backups/borg

# must match the fstab mountpoint
EXTERNAL_MOUNT=/mnt/borg-external
EXTERNAL_REPO="$EXTERNAL_MOUNT/borg"

# from `blkid`, empty until the drive is partitioned
EXTERNAL_FS_UUID=

# managed: mount only during backups; normal: mounts on insert, stays mounted
# (normal never auto-backs-up on insert, only mounts - see man page)
MOUNT_MODE=managed

# which service the udev rule wants in managed mode: mount-test (safe,
# no-op) or the real backup; irrelevant in normal mode (never auto-runs)
ARM_TARGET=borg-external-mount-test.service

# desktop username for notify-send (needs a graphical session); blank disables it
NOTIFY_USER=

# root:root mode 600, shared by both repos
PASSPHRASE_FILE=/etc/borg/passphrase

COMPRESSION=zstd,6
LOCK_WAIT=300
RETENTION=(--keep-daily 7 --keep-weekly 4 --keep-monthly 6)
CHECK_INTERVAL_DAYS=30

# e.g. (--exclude '/home/youruser/backup'), only if LOCAL_REPO ends up inside a source
EXTRA_EXCLUDE_ARGS=()
